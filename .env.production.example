# ========================================================
# Variables d'environnement Coolify (Production)
# À copier dans l'onglet "Environment Variables" de Coolify
# ========================================================

# --- Application Laravel ---
APP_NAME=QuizBall
APP_ENV=production
# Clé d'application Laravel (ex: générée avec `php artisan key:generate --show`)
APP_KEY=base64:7v+2jTSnRNtupINEG5k1s0wDa68hxNlS0ZYh9ARkpUg=
APP_DEBUG=false
APP_URL=https://ton-domaine.com

# --- Connexion à ta base MySQL (déjà hébergée) ---
DB_CONNECTION=mysql
# Hôte MySQL : IP de ton VPS, nom du conteneur DB Coolify, ou 172.17.0.1
DB_HOST=ton_hote_mysql
DB_PORT=3306
DB_DATABASE=nom_de_ta_base
DB_USERNAME=ton_utilisateur_mysql
DB_PASSWORD=ton_mot_de_passe_mysql

# --- Port d'écoute Frontend ---
FRONTEND_PORT=80
