# ========================================================
# Variables d'environnement Coolify (Production)
# À renseigner dans l'onglet "Environment Variables" de Coolify
# ========================================================

# 1. URL interne de ta base MySQL Coolify
# (Format: mysql://utilisateur:mot_de_passe@hote:3306/nom_de_base)
DATABASE_URL=mysql://utilisateur:mot_de_passe@hote_interne_coolify:3306/nom_de_base

# 2. L'URL publique de ton site
APP_URL=https://quizball.ton-domaine.com

# 3. Clé de sécurité Laravel (générée ou valeur par défaut)
APP_KEY=base64:7v+2jTSnRNtupINEG5k1s0wDa68hxNlS0ZYh9ARkpUg=
